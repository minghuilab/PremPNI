        "README": {
          "description": "S1336 contains 1,336 forward protein–DNA mutation records. Identifiers, comparison-subset membership and experimental ΔΔG values follow Supplementary Data S2. The 20 handcrafted feature names and their order follow Supplementary Data S3.PremPDI2 predictions are the mean predictions of three forward-trained MLP models. Structure-model predictions were generated by forward-trained CatBoost using leave-one-complex-out cross-validation (LOCOV)."
        },
        "S1336": {
          "rows": 1336,
          "columns": [
            "PDB ID",
